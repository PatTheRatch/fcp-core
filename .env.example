# Copy to .env for local development. Values match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://fcp:fcp@localhost:5432/fcp
TEST_DATABASE_URL=postgresql+psycopg://fcp:fcp@localhost:5432/fcp_test

# Only needed for scripts/espn_probe.py. ESPN_LEAGUE_ID and ESPN_SEASON are
# public. ESPN_SWID and ESPN_S2 are the cookies from a logged-in espn.com
# session (required for a private league) — treat them as secrets.
ESPN_LEAGUE_ID=
ESPN_SEASON=
ESPN_SWID=
ESPN_S2=
