# The read-only API, on the tailnet only.
#
# Install (from a checkout at /opt/fcp-core):
#     sudo cp deploy/fcp-core-api.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now fcp-core-api.service
#
# Status:   systemctl status fcp-core-api
# Logs:     journalctl -u fcp-core-api -f
# Remove:   sudo systemctl disable --now fcp-core-api.service
#
# The bind address is what keeps this private in single mode
# (FCP_AUTH_MODE=single): every request is the owner and nothing is checked,
# so it listens on the Tailscale address and nowhere else.
#
# In accounts mode (FCP_AUTH_MODE=accounts) sign-in and the scope checks are
# enforced on every route, and Caddy may answer for the public name and proxy
# to this same tailnet address -- which is what the container on this host
# can reach. The bind does not change either way. Before switching, run
# `scripts/preflight_public.py` and follow docs/cutover.md.

[Unit]
Description=fcp-core - read-only API (tailnet only)
Documentation=https://github.com/PatTheRatch/fcp-core
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=exec
User=aisha
Group=aisha
WorkingDirectory=/opt/fcp-core
ExecStart=/opt/fcp-core/scripts/serve_api.sh
Restart=on-failure
RestartSec=5

# Tailscale may not have an address the instant the network is up.
TimeoutStartSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
