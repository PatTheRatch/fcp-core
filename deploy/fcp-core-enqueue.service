# Put the schedule's jobs on the queue. Paired with fcp-core-enqueue.timer.
# NOT INSTALLED YET (docs/jobs.md, "Switching over").
#
# Install:
#     sudo cp deploy/fcp-core-enqueue.* /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now fcp-core-enqueue.timer
#
# Run one now:   sudo -u aisha /opt/fcp-core/.venv/bin/python scripts/enqueue.py --schedule morning
# Watch:         journalctl -u fcp-core-enqueue.service -n 30; logs/scheduled-enqueue.log
# Remove:        sudo systemctl disable --now fcp-core-enqueue.timer
#
# Seconds: it writes rows and runs nothing. The worker runs the jobs.

[Unit]
Description=fcp-core - enqueue the schedule's jobs
Documentation=https://github.com/PatTheRatch/fcp-core
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=aisha
Group=aisha
WorkingDirectory=/opt/fcp-core
ExecStart=/opt/fcp-core/scripts/scheduled_enqueue.sh
TimeoutStartSec=300

# Exit 69: the database was unreachable, nothing attempted. Left as a
# failure on purpose, as for the other units.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/fcp-core
